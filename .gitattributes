# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.prisma text eol=lf

# Ensure pnpm files are treated correctly
pnpm-lock.yaml text eol=lf
