generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Role hierarchy (Phase 4 §8.1): OWNER > ADMIN > MODERATOR > MEMBER. The
// permission map in services/room/permissions.ts is the single source of truth
// for what each role can actually do.
enum ChatRoomRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  VOICE
  FILE
  SYSTEM
}

// Channel kind. TEXT is fully implemented; VOICE is added in the calling phase.
// ANNOUNCEMENT and FORUM are reserved so future phases need no schema churn.
enum ChannelType {
  TEXT
  VOICE
  ANNOUNCEMENT
  FORUM
}

enum AttachmentStatus {
  PENDING
  ATTACHED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ChatRoom {
  id            String    @id @default(cuid())
  name          String
  description   String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?
  avatar        String?

  User User @relation(fields: [createdBy], references: [id])

  ChatRoomMember ChatRoomMember[]
  Message        Message[]
  invitations    RoomInvitation[]
  joinRequests   RoomJoinRequest[]
  joinLinks      RoomJoinLink[]
  readReceipts   ChatRoomReadReceipt[]
  categories     Category[]
  channels       Channel[]
  roomBans       RoomBan[]

  @@index([createdBy])
}

// A group of related channels inside a Room. Deleting a category keeps its
// channels — the service layer moves them to "Uncategorized" (categoryId null)
// instead of cascading (onDelete: SetNull on Channel.categoryId).
model Category {
  id        String   @id @default(cuid())
  roomId    String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ChatRoom ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  Channel  Channel[]

  @@unique([roomId, name])
  @@index([roomId, position])
}

// The primary conversation unit inside a Room. Text channels hold messages;
// voice channels (Phase 7) hold call sessions instead. Names are unique per
// Room (Discord-style), normalized to lowercase-hyphen form by the validator.
model Channel {
  id               String      @id @default(cuid())
  roomId           String
  categoryId       String?
  name             String
  topic            String?
  type             ChannelType @default(TEXT)
  position         Int         @default(0)
  // Max participants allowed in a voice channel. Ignored for TEXT channels.
  participantLimit Int         @default(25)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  ChatRoom       ChatRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  Category       Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  Message        Message[]
  readReceipts   ChannelReadReceipt[]
  MessageMention MessageMention[]
  callSessions   CallSession[]

  @@unique([roomId, name])
  @@index([roomId, position])
  @@index([categoryId])
}

enum ChatRoomNotificationPref {
  ALL
  MENTIONS
  MUTED
}

model ChatRoomMember {
  id               String                   @id @default(cuid())
  userId           String
  chatRoomId       String
  role             ChatRoomRole             @default(MEMBER)
  joinedAt         DateTime                 @default(now())
  // Per-room display name shown instead of the global display name (Phase 4).
  nickname         String?
  // Notification preferences for this room (Phase 5).
  notificationPref ChatRoomNotificationPref @default(ALL)
  // Temporary mute: while set (and in the future), the member cannot send
  // messages. Null means "not muted". Expired mutes are treated as unmuted.
  mutedUntil       DateTime?

  ChatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  User     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chatRoomId])
  @@index([chatRoomId])
  @@index([userId])
}

// A room-level ban. Bans persist after the membership is removed (unlike a
// `banned` flag on ChatRoomMember, which would vanish on leave) so admins can
// review and lift them. Members are re-admitted via the normal invite/link flow.
model RoomBan {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  bannedById String
  reason     String?
  createdAt  DateTime @default(now())

  ChatRoom ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  User     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User     @relation("RoomBanBannedBy", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model Message {
  id           String  @id @default(cuid())
  content      String?
  senderId     String
  chatRoomId   String?
  directChatId String?
  // The channel a room message belongs to. Null for DM messages and for room
  // messages that predate the channels migration (backfilled to #general).
  channelId    String?

  messageType MessageType @default(TEXT)

  createdAt DateTime @default(now())

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  editedAt  DateTime?

  ChatRoom    ChatRoom?        @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  DirectChat  DirectChat?      @relation(fields: [directChatId], references: [id], onDelete: Cascade)
  Channel     Channel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  User        User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  mentions    MessageMention[]

  DirectChatReadReceipt DirectChatReadReceipt[] @relation("DirectChatReadReceiptLastMessage")
  ChatRoomReadReceipt   ChatRoomReadReceipt[]   @relation("ChatRoomReadReceiptLastMessage")
  ChannelReadReceipt    ChannelReadReceipt[]    @relation("ChannelReadReceiptLastMessage")

  @@index([chatRoomId, createdAt])
  @@index([directChatId, createdAt])
  @@index([channelId, createdAt])
}

model Attachment {
  id            String           @id @default(cuid())
  messageId     String?
  uploaderId    String
  s3Key         String           @unique
  filename      String
  mimeType      String
  size          Int
  width         Int?
  height        Int?
  duration      Int?
  // Precomputed waveform amplitude samples (0..1) captured during recording
  // so playback renders the waveform without decoding the audio file.
  waveformPeaks Json?
  thumbnailKey  String?
  status        AttachmentStatus @default(PENDING)
  createdAt     DateTime         @default(now())

  Message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([uploaderId, status])
}

model DirectChat {
  id                            String                  @id @default(cuid())
  user1Id                       String
  user2Id                       String
  createdAt                     DateTime                @default(now())
  lastMessageAt                 DateTime?
  User_DirectChat_user1IdToUser User                    @relation("DirectChat_user1IdToUser", fields: [user1Id], references: [id], onDelete: Cascade)
  User_DirectChat_user2IdToUser User                    @relation("DirectChat_user2IdToUser", fields: [user2Id], references: [id], onDelete: Cascade)
  Message                       Message[]
  readReceipts                  DirectChatReadReceipt[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

// A friend request between two users. Direction matters: `sender` asked to add
// `recipient`. `pairKey` is the lexicographically-ordered
// `{senderId}|{recipientId}` string so a single partial unique index
// (added in the migration, on `pairKey` WHERE status = 'PENDING') can prevent
// two PENDING requests between the same pair in EITHER direction at the DB
// level — Prisma's DSL cannot express a partial unique index.
model FriendRequest {
  id          String              @id @default(cuid())
  senderId    String
  recipientId String
  pairKey     String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  sender    User @relation("FriendRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendRequestsReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status])
  @@index([senderId, status])
  @@index([pairKey])
}

// A confirmed friendship. Symmetric: `userAId` < `userBId` is enforced by the
// service layer at insert time (same normalized-ordering pattern as
// DirectChat.user1Id/user2Id), so the @@unique below prevents a duplicate row
// regardless of who initiated the friendship.
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipsUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipsUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

// A user (blocker) suppressing another user (blocked). Both directions are
// checked wherever blocking matters (friend requests, DMs, etc.).
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model User {
  id                                  String            @id
  email                               String            @unique
  displayName                         String?
  username                            String            @unique
  passwordHash                        String?
  avatar                              String?
  bio                                 String?
  gender                              Gender?
  dateOfBirth                         DateTime?
  // Manual status chosen by the user (AVAILABLE/BUSY/DND/AWAY/INVISIBLE).
  // Stored as String (not an enum) so new statuses never require a migration;
  // the API validator enforces the allowed set at the boundary.
  status                              String            @default("AVAILABLE")
  // Optional free-text status shown alongside the manual status; kept separate
  // from `status` so clearing the text never changes the selected status.
  customStatus                        String?
  // Privacy: what THIS user exposes to others (never what they can see).
  showOnlineStatus                    Boolean           @default(true)
  showTypingStatus                    Boolean           @default(true)
  createdAt                           DateTime          @default(now())
  updatedAt                           DateTime          @updatedAt
  sessions                            Session[]
  ChatRoom                            ChatRoom[]
  ChatRoomMember                      ChatRoomMember[]
  DirectChat_DirectChat_user1IdToUser DirectChat[]      @relation("DirectChat_user1IdToUser")
  DirectChat_DirectChat_user2IdToUser DirectChat[]      @relation("DirectChat_user2IdToUser")
  Message                             Message[]
  Attachment                          Attachment[]
  joinRequests                        RoomJoinRequest[]
  reviewedJoinRequests                RoomJoinRequest[] @relation("JoinRequestReviewedBy")

  receivedInvitations    RoomInvitation[]        @relation("InvitedUser")
  sentInvitations        RoomInvitation[]        @relation("InvitedBy")
  createdJoinLinks       RoomJoinLink[]
  recoveryCodes          RecoveryCode[]
  directChatReadReceipts DirectChatReadReceipt[]
  chatRoomReadReceipts   ChatRoomReadReceipt[]
  channelReadReceipts    ChannelReadReceipt[]
  mentions               MessageMention[]
  pushSubscriptions      PushSubscription[]

  friendRequestsSent     FriendRequest[]   @relation("FriendRequestsSent")
  friendRequestsReceived FriendRequest[]   @relation("FriendRequestsReceived")
  friendshipsA           Friendship[]      @relation("FriendshipsUserA")
  friendshipsB           Friendship[]      @relation("FriendshipsUserB")
  userBlocksCreated      UserBlock[]       @relation("UserBlocksCreated")
  userBlocksReceived     UserBlock[]       @relation("UserBlocksReceived")
  roomBansCreated        RoomBan[]         @relation("RoomBanBannedBy")
  roomBansReceived       RoomBan[]
  callParticipations     CallParticipant[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RoomInvitation {
  id String @id @default(uuid())

  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  invitedUserId String
  invitedUser   User   @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  status InvitationStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([roomId, invitedUserId, status], name: "unique_pending_invitation")
  @@index([roomId])
  @@index([invitedUserId])
}

model RoomJoinRequest {
  id String @id @default(uuid())

  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status JoinRequestStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?   @relation("JoinRequestReviewedBy", fields: [reviewedById], references: [id])

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  @@unique([roomId, userId, status], name: "unique_pending_join_request")
  @@index([roomId])
  @@index([userId])
}

model RoomJoinLink {
  id String @id @default(uuid())

  token  String   @unique
  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  maxUses   Int?
  usedCount Int  @default(0)

  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([createdById])
}

model RecoveryCode {
  id String @id @default(cuid())

  userId String
  codeId String

  hash String

  used      Boolean   @default(false)
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeId])
  @@index([userId, used])
}

// A browser's Web Push subscription, registered via POST /api/push/subscribe.
// The endpoint is globally unique (browsers generate one per origin+user) and
// is used to deliver OS notifications when the user is not looking at the app.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Tracks the last message each user has read in a direct conversation.
// The cursor (lastReadMessageId / lastReadMessageCreatedAt) is nullable:
// if the referenced message is deleted (onDelete: SetNull), the cursor
// becomes NULL, which the unread-count query treats identically to "no
// receipt exists" — all messages from other users are considered unread.
model DirectChatReadReceipt {
  id                       String    @id @default(cuid())
  userId                   String
  directChatId             String
  lastReadMessageId        String?
  lastReadMessageCreatedAt DateTime?
  updatedAt                DateTime  @updatedAt

  User            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  DirectChat      DirectChat @relation(fields: [directChatId], references: [id], onDelete: Cascade)
  LastReadMessage Message?   @relation("DirectChatReadReceiptLastMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([userId, directChatId])
  @@index([userId])
  @@index([directChatId])
}

// Same pattern as DirectChatReadReceipt but for chat room conversations.
model ChatRoomReadReceipt {
  id                       String    @id @default(cuid())
  userId                   String
  chatRoomId               String
  lastReadMessageId        String?
  lastReadMessageCreatedAt DateTime?
  updatedAt                DateTime  @updatedAt

  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ChatRoom        ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  LastReadMessage Message? @relation("ChatRoomReadReceiptLastMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([userId, chatRoomId])
  @@index([userId])
  @@index([chatRoomId])
}

// Same cursor pattern as ChatRoomReadReceipt but scoped to one channel, so each
// channel in a Room tracks its own read position independently (Phase 6 §10.1).
// The sidebar derives per-channel Unread/Mentioned/Read/Muted states from this
// cursor plus the mentions stored on MessageMention.
model ChannelReadReceipt {
  id                       String    @id @default(cuid())
  userId                   String
  channelId                String
  lastReadMessageId        String?
  lastReadMessageCreatedAt DateTime?
  updatedAt                DateTime  @updatedAt

  User            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  LastReadMessage Message? @relation("ChannelReadReceiptLastMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])
}

// A user mentioned in a room message (@username), stored at write time so the
// sidebar can show a Mentioned badge and MENTIONS notification prefs can be
// honored without re-parsing content on every read. Only the mentioned user's
// own rows are meaningful for unread state; duplicates per message are allowed
// (a user may be @-mentioned more than once) but unique per (message, user).
model MessageMention {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  roomId    String
  channelId String?
  createdAt DateTime @default(now())

  Message Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  User    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Channel Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, channelId])
  @@index([channelId])
  @@index([roomId])
}

// Persistent record of a voice-call instance in a channel.
// LiveKit owns real-time state (speaking, track publish, etc.); this table
// tracks history, participant count, and stale-session cleanup.
model CallSession {
  id        String    @id @default(cuid())
  channelId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  Channel      Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([channelId])
  @@index([endedAt])
}

// A user who joined a CallSession. Records join/leave timestamps for
// participant count queries and stale reaping. Transient media state
// (mute, camera, screen-share) lives in LiveKit, not here.
model CallParticipant {
  id        String    @id @default(cuid())
  sessionId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  session CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@index([leftAt])
}
